
# Provider: openai, google ou ollama
LLM_PROVIDER=ollama

# Ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Para workspace baseada em agentes, preencha o ID real e escolha o ambiente:
# LANGSMITH_AGENT_ID=
# LANGSMITH_AGENT_ENVIRONMENT=local
# Para workspace baseada em projetos, use apenas o nome do projeto:
# LANGSMITH_PROJECT=langchain-summarizetext-lcel
# Configure o endpoint somente se sua conta estiver em outra regiao:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
